# 비밀값 — 절대 올리지 않는다. 한 번 올라가면 기록에 영원히 남는다.
.env
.env.*
!.env.example

# 설치한 라이브러리 — package.json 으로 언제든 다시 만들 수 있다.
node_modules/

# macOS Finder 가 만드는 파일 — 폴더만 열어도 바뀌어서 진짜 변경을 가린다.
.DS_Store

# 빌드 결과물 — 소스에서 다시 만들어진다. Vercel 도 직접 빌드한다.
dist/
build/

# Vercel CLI 의 로컬 연결 정보 — 내 컴퓨터에서만 의미가 있다.
.vercel/

# 로그 — 그때그때 생겼다 사라지는 것이라 기록할 값이 없다.
*.log
npm-debug.log*

# 에디터 개인 설정 — 혼자 쓰는 프로젝트라 코드와 함께 관리할 필요가 없다.
.vscode/

# 플러그인 시험용 볼트 — 내 메모라서 코드 저장소에 올라가면 안 된다.
.obsidian/
test-vault/
